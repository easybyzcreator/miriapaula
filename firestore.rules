rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras completas para o aplicativo do Cardápio Digital & Painel Administrativo
    // Permite leitura e escrita de configurações, produtos, categorias, pedidos, clientes e custos
    match /configuracoes/{document=**} {
      allow read, write: if true;
    }
    
    match /produtos/{document=**} {
      allow read, write: if true;
    }
    
    match /categorias/{document=**} {
      allow read, write: if true;
    }
    
    match /acompanhamentos/{document=**} {
      allow read, write: if true;
    }
    
    match /galerias/{document=**} {
      allow read, write: if true;
    }
    
    match /pedidos/{document=**} {
      allow read, write: if true;
    }
    
    match /clientes/{document=**} {
      allow read, write: if true;
    }
    
    match /custos_variaveis/{document=**} {
      allow read, write: if true;
    }
    
    match /insumos/{document=**} {
      allow read, write: if true;
    }
    
    match /fichas_tecnicas/{document=**} {
      allow read, write: if true;
    }
    
    // Regra geral para quaisquer subcoleções adicionais
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

